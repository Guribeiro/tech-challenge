  "item": [
    {
      "name": "0. Saúde",
      "item": [
        {
          "name": "Health check (gateway → NLB → API → RDS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('banco up', () => pm.expect(pm.response.json().info.database.status).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Autenticação do cliente por CPF (Lambda)",
      "item": [
        {
          "name": "CPF ativo → 200 e token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cpf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cpf"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfAtivo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('tokenCliente', corpo.accessToken);",
                  "pm.collectionVariables.set('clienteId', corpo.cliente.id);",
                  "const payload = JSON.parse(Buffer.from(corpo.accessToken.split('.')[1], 'base64').toString());",
                  "pm.test('token com perfil CLIENTE', () => pm.expect(payload.role).to.eql('CLIENTE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CPF bloqueado → 403",
