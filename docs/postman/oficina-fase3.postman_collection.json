    {
      "name": "2. Funcionário (login na API) e dados de apoio",
      "item": [
        {
          "name": "Login da recepção",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/sign-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "sign-in"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailFuncionario}}\",\n  \"senha\": \"{{senhaFuncionario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenFuncionario', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Veículo do cliente autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenFuncionario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/veiculos?pagina=1&limite=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "veiculos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const clienteId = pm.collectionVariables.get('clienteId');",
                  "const veiculo = pm.response.json().veiculos.find((v) => v.clienteId === clienteId);",
                  "pm.test('cliente possui veículo', () => pm.expect(veiculo).to.be.ok);",
                  "pm.collectionVariables.set('veiculoId', veiculo.id);",
                  "pm.collectionVariables.set('placa', veiculo.placa);"
                ]
              }
            }
          ]
        },
        {
          "name": "Serviço do catálogo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenFuncionario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servicos?pagina=1&limite=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('servicoId', pm.response.json().servicos[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Produto com estoque",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenFuncionario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/produtos?pagina=1&limite=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const produto = pm.response.json().produtos.find((p) => p.quantidadeDisponivel > 0);",
                  "pm.collectionVariables.set('produtoId', produto.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Ordem de serviço com token do cliente (Lambda Authorizer)",
      "item": [
        {
          "name": "Abrir OS → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordens-servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordens-servicos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"descricao\": \"Revisão periódica com troca de óleo\",\n  \"eGarantia\": false,\n  \"servicos\": [\n    {\n      \"servicoId\": \"{{servicoId}}\"\n    }\n  ],\n  \"componentes\": [\n    {\n      \"produtoId\": \"{{produtoId}}\",\n      \"quantidade\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O authorizer valida o token no gateway; a API revalida e aplica o perfil (RECEPCAO ou CLIENTE). O cliente só abre OS para si e para veículos próprios."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const os = pm.response.json();",
                  "pm.collectionVariables.set('ordemServicoId', os.id);",
                  "pm.test('OS para o próprio cliente', () => pm.expect(os.clienteId).to.eql(pm.collectionVariables.get('clienteId')));",
                  "pm.test('status RECEBIDA', () => pm.expect(os.status).to.eql('RECEBIDA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir OS sem token → 401",
          "request": {
