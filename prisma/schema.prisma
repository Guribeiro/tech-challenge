// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MECANICO
  RECEPCAO
  ADMIN
  CLIENTE
}

enum TipoProduto {
  INSUMO
  PECA
}

enum UnidadeMedida {
  UN
  L
  KG
  JOGO
  METRO
}

enum ServicoCategoria {
  SEGURANCA
  MANUTENCAO_PREVENTIVA
  ESTETICA
  ELETRICA
  MECANICA_GERAL
}

model Usuario {
  id           String    @id
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  role         Role

  @@map("usuarios")
}

enum ClienteTipo {
  PJ
  PF
}

model Cliente {
  id           String      @id
  nome         String
  email        String      @unique
  cpf          String      @unique
  telefone     String
  tipo         ClienteTipo
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime?   @updatedAt @map("atualizado_em")
  deletadoEm   DateTime?   @map("deletado_em")
  veiculos     Veiculo[]

  @@map("clientes")
}

model Mecanico {
  id            String    @id
  nome          String
  email         String    @unique
  cpf           String    @unique
  especialidade String?
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime? @updatedAt @map("atualizado_em")

  @@map("mecanicos")
}

model Veiculo {
  id            String    @id
  placa         String    @unique
  marca         String
  modelo        String
  ano           Int
  cor           String?
  quilometragem Int?
  combustivel   String?
  observacoes   String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime? @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String  @map("cliente_id")

  @@map("veiculos")
}

model Produto {
  id                  String         @id
  nome                String
  tipo                TipoProduto
  marca               String?
  descricao           String?
  codigoSKU           String?        @unique @map("codigo_sku")
  codigoFabricante    String?        @map("codigo_fabricante")
  precoUnitario       Int            @map("preco_unitario")
  precoCusto          Int            @map("preco_custo")
  quantidadeEstoque   Int            @map("quantidade_estoque")
  quantidadeReservada Int?           @map("quantidade_reservada")
  estoqueMinimo       Int?           @map("estoque_minimo")
  estoqueMaximo       Int?           @map("estoque_maximo")
  unidadeMedida       UnidadeMedida? @map("unidade_medida")
  localizacao         String?
  criadoEm            DateTime       @default(now()) @map("criado_em")
  atualizadoEm        DateTime?      @updatedAt @map("atualizado_em")
  desativadoEm        DateTime?      @map("desativado_em")
}

model Servico {
  id              String           @id
  categoria       ServicoCategoria
  nome            String
  descricao       String?
  valorReferencia Int
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime?        @updatedAt @map("atualizado_em")
  desativadoEm    DateTime?        @map("desativado_em")
}
