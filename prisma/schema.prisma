// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MECANICO
  RECEPCAO
  ADMIN
  CLIENTE
}

enum TipoProduto {
  INSUMO
  PECA
}

enum UnidadeMedida {
  UN
  L
  KG
  JOGO
  METRO
}

enum ServicoCategoria {
  SEGURANCA
  MANUTENCAO_PREVENTIVA
  ESTETICA
  ELETRICA
  MECANICA_GERAL
}

enum TipoPrioridade {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

enum StatusOS {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  EM_EXECUCAO
  AUTORIZADA
  PRONTA_PARA_INICIAR
  FINALIZADA
  ENTREGUE
  ENCERRADA_REJEICAO
  ENCERRADA
}

enum StatusOrcamento {
  CRIADO
  ENVIADO
  APROVADO
  RECUSADO
  RENEGOCIADO
  REJEITADO_DEFINITIVO
}

enum StatusFatura {
  PENDENTE
  PAGA
  CANCELADA
}

enum MotivoTermoLiberacao {
  PAGAMENTO_APROVADO
  REJEICAO_ORCAMENTO
}

model Usuario {
  id           String        @id
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime?     @updatedAt @map("atualizado_em")
  role         Role
  notificacaos Notificacao[]

  @@map("usuarios")
}

enum ClienteTipo {
  PJ
  PF
}

model Cliente {
  id            String         @id
  nome          String
  email         String         @unique
  documento     String         @unique
  telefone      String
  tipo          ClienteTipo
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  deletadoEm    DateTime?      @map("deletado_em")
  veiculos      Veiculo[]
  ordemServicos OrdemServico[]
  orcamentos    Orcamento[]

  @@map("clientes")
}

model Mecanico {
  id            String         @id
  nome          String
  email         String         @unique
  cpf           String         @unique
  especialidade String?
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  desativadoEm  DateTime?      @map("desativado_em")
  ordemServicos OrdemServico[]

  @@map("mecanicos")
}

model Recepcionista {
  id           String    @id
  nome         String
  email        String    @unique
  cpf          String    @unique
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  desativadoEm DateTime? @map("desativado_em")

  @@map("recepcionistas")
}

model Veiculo {
  id            String    @id
  placa         String    @unique
  marca         String
  modelo        String
  ano           Int
  cor           String?
  quilometragem Int?
  combustivel   String?
  observacoes   String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime? @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  clienteId     String         @map("cliente_id")
  ordemServicos OrdemServico[]

  @@map("veiculos")
}

model Produto {
  id                      String                   @id
  nome                    String
  tipo                    TipoProduto
  marca                   String?
  descricao               String?
  codigoSKU               String?                  @unique @map("codigo_sku")
  codigoFabricante        String?                  @map("codigo_fabricante")
  precoUnitario           Int                      @map("preco_unitario")
  precoCusto              Int                      @map("preco_custo")
  quantidadeEstoque       Int                      @map("quantidade_estoque")
  quantidadeReservada     Int?                     @map("quantidade_reservada")
  estoqueMinimo           Int?                     @map("estoque_minimo")
  estoqueMaximo           Int?                     @map("estoque_maximo")
  unidadeMedida           UnidadeMedida?           @map("unidade_medida")
  localizacao             String?
  criadoEm                DateTime                 @default(now()) @map("criado_em")
  atualizadoEm            DateTime?                @updatedAt @map("atualizado_em")
  desativadoEm            DateTime?                @map("desativado_em")
  ordemServicoComponentes OrdemServicoComponente[]
  orcamentoComponentes    OrcamentoComponente[]

  @@map("produtos")
}

model Servico {
  id                   String                @id
  categoria            ServicoCategoria
  nome                 String
  descricao            String?
  valorReferencia      Int
  criadoEm             DateTime              @default(now()) @map("criado_em")
  atualizadoEm         DateTime?             @updatedAt @map("atualizado_em")
  desativadoEm         DateTime?             @map("desativado_em")
  ordemServicoServicos OrdemServicoServico[]
  orcamentoServicos    OrcamentoServico[]

  @@map("servicos")
}

model OrdemServico {
  id        String  @id
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String  @map("cliente_id")

  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])
  veiculoId String  @map("veiculo_id")

  mecanico   Mecanico? @relation(fields: [mecanicoId], references: [id])
  mecanicoId String?   @map("mecanico_id")

  descricao String

  prioridade     TipoPrioridade @default(BAIXA)
  prioridadePeso Int            @default(1) @map("prioridade_peso")

  eGarantia Boolean @map("e_garantia")

  status          StatusOS
  criadoEm        DateTime                 @default(now()) @map("criado_em")
  atualizadoEm    DateTime?                @updatedAt @map("atualizado_em")
  iniciadoEm      DateTime?                @map("iniciado_em")
  finalizadoEm    DateTime?                @map("finalizado_em")
  servicos        OrdemServicoServico[]
  componentes     OrdemServicoComponente[]
  orcamentos      Orcamento[]
  termoLiberacaos TermoLiberacao[]

  @@map("ordem_servicos")
}

model OrdemServicoServico {
  id String @id

  servicoId String  @map("servico_id")
  servico   Servico @relation(fields: [servicoId], references: [id])

  ordemServicoId String       @map("ordem_servico_id")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id])

  nome          String
  descricao     String?
  categoria     ServicoCategoria
  precoUnitario Int              @map("preco_unitario")
  criadoEm      DateTime         @default(now()) @map("criado_em")

  @@map("ordem_servico_servicos")
}

model OrdemServicoComponente {
  id String @id

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id])

  ordemServicoId String       @map("ordem_servico_id")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id])

  nome             String
  tipo             TipoProduto
  marca            String?
  codigoSKU        String?        @map("codigo_sku")
  codigoFabricante String?        @map("codigo_fabricante")
  descricao        String?
  precoCusto       Int            @map("preco_custo")
  precoUnitario    Int            @map("preco_unitario")
  unidadeMedida    UnidadeMedida? @map("unidade_medida")
  quantidade       Int
  criadoEm         DateTime       @default(now()) @map("criado_em")

  @@map("ordem_servico_componentes")
}

model Orcamento {
  id                  String          @id
  ordemServicoId      String          @map("ordem_servico_id")
  clienteId           String          @map("cliente_id")
  versao              Int
  descontoPorcentagem Int             @default(0) @map("desconto_porcentagem")
  status              StatusOrcamento
  criadoEm            DateTime        @default(now()) @map("criado_em")
  atualizadoEm        DateTime?       @updatedAt @map("atualizado_em")

  servicos    OrcamentoServico[]
  componentes OrcamentoComponente[]

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  faturas      Fatura[]

  @@map("orcamentos")
}

model OrcamentoServico {
  id String @id

  servicoId String  @map("servico_id")
  servico   Servico @relation(fields: [servicoId], references: [id])

  orcamentoId String    @map("orcamento_id")
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])

  nome          String
  descricao     String?
  categoria     ServicoCategoria
  precoUnitario Int              @map("preco_unitario")
  criadoEm      DateTime         @default(now()) @map("criado_em")

  @@map("orcamento_servicos")
}

model OrcamentoComponente {
  id String @id

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id])

  orcamentoId String    @map("orcamento_id")
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])

  nome             String
  tipo             TipoProduto
  marca            String?
  codigoSKU        String?        @map("codigo_sku")
  codigoFabricante String?        @map("codigo_fabricante")
  descricao        String?
  precoCusto       Int            @map("preco_custo")
  precoUnitario    Int            @map("preco_unitario")
  unidadeMedida    UnidadeMedida? @map("unidade_medida")
  quantidade       Int
  criadoEm         DateTime       @default(now()) @map("criado_em")

  @@map("orcamento_componentes")
}

model Fatura {
  id String @id

  orcamentoId String    @map("orcamento_id")
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])

  status     StatusFatura
  valorTotal Int          @map("valor_total")

  emitidaEm DateTime  @default(now()) @map("emitida_em")
  pagaEm    DateTime? @updatedAt @map("paga_em")

  @@map("faturas")
}

model TermoLiberacao {
  id String @id

  ordemServicoId String       @map("ordem_servico_id")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id])

  placaVeiculo String
  motivo       MotivoTermoLiberacao
  conteudo     String

  emitidoEm DateTime @default(now()) @map("emitido_em")

  @@map("termo_liberacoes")
}

model Notificacao {
  id String @id

  destinatarioId String  @map("destinatario_id")
  destinatario   Usuario @relation(fields: [destinatarioId], references: [id])

  titulo   String
  conteudo String
  template String?
  contexto Json?
  lidaEm   DateTime? @map("lida_em")
  criadaEm DateTime  @default(now()) @map("criada_em")

  @@map("notificacoes")
}
