// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MECANICO
  RECEPCAO
  ADMIN
  CLIENTE
}

model Usuario {
  id           String    @id
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  role         Role

  @@map("usuarios")
}

enum ClienteTipo {
  PJ
  PF
}

model Cliente {
  id           String      @id
  nome         String
  email        String      @unique
  telefone     String
  tipo         ClienteTipo
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime?   @updatedAt @map("atualizado_em")

  @@map("clientes")
}

model Mecanico {
  id            String    @id
  nome          String
  email         String    @unique
  cpf           String    @unique
  especialidade String?
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime? @updatedAt @map("atualizado_em")

  @@map("mecanicos")
}

model Veiculo {
  id            String    @id
  placa         String    @unique
  marca         String
  modelo        String
  ano           Int
  cor           String?
  quilometragem Int?
  combustivel   String?
  observacoes   String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime? @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  @@map("veiculos")
}
