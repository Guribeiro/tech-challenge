# --- Aplicação e Banco Principal ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oficina_db
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oficina_db?schema=public"

# --- Autenticação ---
# Compartilhado com a Lambda de autenticação por CPF (obrigatório em produção)
JWT_SECRET=troque-este-segredo

# --- Observabilidade ---
LOG_LEVEL=info
APP_ENV=local
# New Relic: sem licença o agente fica desativado
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-app-local
NEW_RELIC_ENABLED=true

# --- Banco de Dados de Testes ---
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres
POSTGRES_TEST_DB=oficina_test_db
POSTGRES_TEST_PORT=5433

# --- SonarQube e Banco Exclusivo do Sonar ---
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar
SONAR_PORT=9000

# (Opcional) Guarde o token gerado pelo SonarQube aqui para usar nos seus scripts
SONAR_TOKEN=squ_113bed345e199a4917f92deda8515c13a383751d
SONAR_HOST_URL=http://localhost:9000