{
  "name": "fiap-tech-challenge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/infra/main.js",
    "start:dev": "npx prisma db push && nest start --watch --builder swc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "db:seed": "prisma db seed",
    "test:cov": "vitest run --coverage",
    "test:cov:ui": "vitest --coverage --ui",
    "db:test:up": "node check-db.js",
    "test:e2e": "dotenv -e .env.test -- prisma migrate deploy && vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:watch": "dotenv -e .env.test -- prisma migrate deploy && vitest --config ./vitest.config.e2e.ts",
    "test:all:ui": "npm run db:test:up && dotenv -e .env.test -- prisma migrate deploy && vitest --config ./vitest.config.all.ts --coverage --ui",
    "test:cov:all": "npm run db:test:up && dotenv -e .env.test -- prisma migrate deploy && vitest run --config ./vitest.config.all.ts --coverage",
    "sonar": "npm run test:cov:all && node --env-file=.env sonar-runner.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@tsconfig/node24": "^24.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "gerador-validador-cpf": "^6.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sonarqube-scanner": "^5.0.0"
  }
}
