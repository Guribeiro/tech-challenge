{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations":"6.0",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "vite.config.ts"
  ]
}